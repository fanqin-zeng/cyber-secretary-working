<Window x:Class="CyberSecretary.TaskDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="新建任务" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Canvas}" Language="zh-CN">
  <Window.Resources><Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,8"/></Style></Window.Resources>
  <StackPanel Margin="30,26,30,26">
    <TextBlock x:Name="Heading" Text="新建任务" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="安排一件重要的事，给它一个明确的时间。" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,8,0,23"/>
    <TextBlock Text="任务名称 *" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="TitleInput" MaxLength="120" AutomationProperties.Name="任务名称"/>
    <Grid Margin="0,19,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="开始时间 *" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><DatePicker x:Name="StartDate" SelectedDateFormat="Short" AutomationProperties.Name="开始日期"/><TextBox x:Name="StartTime" Grid.Column="2" Padding="8,8" MaxLength="5" AutomationProperties.Name="开始时刻" ToolTip="24 小时制，例如 09:00"/></Grid></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="结束时间 *" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><DatePicker x:Name="EndDate" SelectedDateFormat="Short" AutomationProperties.Name="结束日期"/><TextBox x:Name="EndTime" Grid.Column="2" Padding="8,8" MaxLength="5" AutomationProperties.Name="结束时刻" ToolTip="24 小时制，例如 18:00"/></Grid></StackPanel>
    </Grid>
    <Grid Margin="0,19,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="重要程度 *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ImportanceInput" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="重要程度"/>
        <TextBlock Text="-5 至 +5 的整数，≥ +1 为重要" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <CheckBox x:Name="RecurrenceEnabled" Content="周期任务" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
        <Grid x:Name="RecurrenceFields">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=RecurrenceEnabled}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBox x:Name="RecurrenceInterval" MaxLength="10" AutomationProperties.Name="周期数值"/>
          <ComboBox x:Name="RecurrenceUnitInput" Grid.Column="2" DisplayMemberPath="Text" SelectedValuePath="Value" AutomationProperties.Name="周期单位"/>
        </Grid>
      </StackPanel>
    </Grid>
    <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,19,0,8"/>
    <TextBox x:Name="NotesInput" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="备注"/>
    <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource Danger}" FontSize="13" TextWrapping="Wrap" MinHeight="19" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
    <Grid Margin="0,8,0,0"><TextBlock Text="* 必填项" FontSize="12" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" MinWidth="77" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="创建任务" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="105" Click="SaveClick"/></StackPanel></Grid>
  </StackPanel>
</Window>
